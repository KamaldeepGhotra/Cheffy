# Copy to backend/.env for local development.

# Required. Gemini key used for recipe search and suggestions.
GEMINI_API_KEY=your-gemini-api-key

# Optional locally: leave unset to use SQLite at backend/cheffy.db.
# On Render, paste the Supabase connection string (postgres:// and postgresql:// both work).
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Optional locally: browser origins allowed to call the API, comma separated.
# Defaults to the Vite dev server. In production, set the Vercel production URL only.
# ALLOWED_ORIGINS=http://localhost:5173,https://cheffy.vercel.app
